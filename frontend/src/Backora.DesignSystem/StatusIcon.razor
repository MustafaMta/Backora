@* 14px status glyphs: done, failed, warning, running (animated arc), paused, idle (dashed). Colour comes from .ui-status--* *@
<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
    @switch (Kind)
    {
        case "ok":
            <circle cx="7" cy="7" r="6.25" fill="currentColor" />
            <path d="m4.4 7.2 1.8 1.8 3.5-3.7" stroke="var(--surface)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            break;
        case "bad":
            <circle cx="7" cy="7" r="6.25" fill="currentColor" />
            <path d="m4.9 4.9 4.2 4.2m0-4.2L4.9 9.1" stroke="var(--surface)" stroke-width="1.5" stroke-linecap="round" />
            break;
        case "warn":
            <circle cx="7" cy="7" r="6.25" fill="currentColor" />
            <path d="M7 4v3.6" stroke="var(--surface)" stroke-width="1.5" stroke-linecap="round" /><circle cx="7" cy="9.9" r=".9" fill="var(--surface)" />
            break;
        case "running":
            <circle cx="7" cy="7" r="5.75" stroke="currentColor" stroke-width="1.5" opacity=".28" />
            <path class="spin" d="M7 1.25A5.75 5.75 0 0 1 12.75 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="7" cy="7" r="2.2" fill="currentColor" />
            break;
        case "paused":
            <circle cx="7" cy="7" r="5.75" stroke="currentColor" stroke-width="1.5" />
            <path d="M5.6 5v4M8.4 5v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            break;
        default:
            <circle cx="7" cy="7" r="5.75" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 2.1" />
            break;
    }
</svg>
@code {
    /// <summary>ok | bad | warn | running | paused | idle</summary>
    [Parameter] public string Kind { get; set; } = "idle";
}
