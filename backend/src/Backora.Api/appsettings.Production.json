{
  "Platform": { "PublicUrl": "https://backora.example.com" },
  "Encryption": { "ActiveKeyId": "primary" },
  "ForwardedHeaders": { "KnownNetworks": [ "10.128.0.0/14" ] },
  "DataProtection": { "KeysPath": "/data/keys" },
  "Database": { "MigrateOnStartup": true },
  "OpenApi": { "Enabled": false },
  "Worker": {
    "MaxConcurrentBackups": 10,
    "MaxConcurrentTransfers": 4,
    "MaxConcurrentRestores": 2,
    "EnableOperations": false,
    "EnableScheduler": false,
    "EnableRetention": false,
    "EnableNotifications": false
  },
  "ExecutionHost": {
    "PrivateKeyFile": "/run/secrets/execution_host_key",
    "TargetKeyFile": "/run/secrets/execution_host_key"
  }
}
