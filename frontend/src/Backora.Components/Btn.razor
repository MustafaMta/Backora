@* Button / link button. Variant: default | primary | ink | ghost | danger. Size: sm | md | lg. *@
@if (Href is not null && !Disabled)
{
    <a class="@Css" href="@Href" title="@Title" aria-label="@AriaLabel" target="@Target" @attributes="Attributes">@Inner</a>
}
else
{
    <button type="@Type" class="@Css" disabled="@(Disabled || Busy)" aria-busy="@(Busy ? "true" : null)" title="@Title" aria-label="@AriaLabel" @onclick="Click" @attributes="Attributes">@Inner</button>
}
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? TrailingIcon { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public bool Block { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
    private int IconSize => Size == "sm" ? 14 : 16;
    private string Css => string.Join(' ', new[] { "ui-btn", Variant == "default" ? null : $"ui-btn--{Variant}", Size == "md" ? null : $"ui-btn--{Size}", IconOnly ? "ui-btn--icon" : null, Block ? "ui-btn--block" : null, Class }.Where(c => c is not null));
    private RenderFragment Inner => __builder =>
    {
        if (Busy) { <span class="ui-spinner" aria-hidden="true"></span> }
        else if (Icon is not null) { <Icon Name="@Icon" Size="IconSize" /> }
        @ChildContent
        if (TrailingIcon is not null) { <Icon Name="@TrailingIcon" Size="IconSize" /> }
    };
    private Task Click(MouseEventArgs e) => OnClick.HasDelegate ? OnClick.InvokeAsync(e) : Task.CompletedTask;
}
