<div class="ui-field @Class">
    @if (Label is not null) { <label class="ui-label" for="@For">@Label@if (Required) { <span class="req" aria-hidden="true">*</span> }@if (Optional) { <span class="opt">Optional</span> }</label> }
    @ChildContent
    @if (Error is not null) { <div class="ui-error" id="@(For is null ? null : For + "-err")"><Icon Name="alert" Size="12" />@Error</div> }
    else if (Hint is not null) { <div class="ui-hint" id="@(For is null ? null : For + "-hint")">@Hint</div> }
</div>
@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? For { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Optional { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
