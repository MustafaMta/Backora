{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Backora": ""
  },
  "Platform": {
    "PublicUrl": "http://localhost:5200"
  },
  "Jwt": {
    "Issuer": "backora",
    "Audience": "backora-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Encryption": {
    "ActiveKeyId": ""
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "SensitivePerMinute": 30,
    "GlobalPerMinute": 600
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "OpenApi": {
    "Enabled": false
  },
  "Worker": {
    "MaxConcurrentBackups": 10,
    "MaxConcurrentTransfers": 4,
    "MaxConcurrentRestores": 2,
    "PollIntervalSeconds": 5,
    "ClaimIntervalSeconds": 3,
    "LeaseSeconds": 120,
    "SchedulerIntervalSeconds": 20,
    "RetentionIntervalMinutes": 15,
    "NotificationIntervalSeconds": 10,
    "ShutdownTimeoutSeconds": 45
  },
  "Execution": {
    "Enabled": true
  }
}
