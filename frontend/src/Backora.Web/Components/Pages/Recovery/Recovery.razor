@page "/recovery"
<PageTitle>Recovery · Backora</PageTitle>

<PageHead Title="Recovery">
    <Actions>@if (Can(Permissions.RestoresExecute)) { <Btn Variant="primary" Href="/restores/new" Icon="restore">Start a restore</Btn> }</Actions>
    <Below>
        <div class="viewbar">
            <RecoveryTabs Active="points" />
            @if (_sites.Count > 1)
            {
                <span style="width:1px;height:16px;background:var(--line)"></span>
                <nav class="ui-tabs" aria-label="Site">
                    <button type="button" aria-selected="@(_site is null ? "true" : "false")" @onclick="() => SetSite(null)">All sites</button>
                    @foreach (var s in _sites) { <button type="button" aria-selected="@(_site == s.Id ? "true" : "false")" @onclick="() => SetSite(s.Id)">@s.Name</button> }
                </nav>
            }
            <div class="viewbar__end"><SearchBox Placeholder="Filter by backup or server" Value="@_q" OnSearch="SearchAsync" /></div>
        </div>
    </Below>
</PageHead>

<div class="app-page">
    @if (_error is not null) { <Empty Error="true" Title="We couldn't load recovery points" Message="@_error"><Actions><Btn OnClick="LoadAsync" Icon="refresh">Try again</Btn></Actions></Empty> }
    else if (_page is null) { <ListSkel /> }
    else if (_page.Items.Count == 0)
    {
        @if (string.IsNullOrEmpty(_q) && _site is null) { <Empty Art="restore" Title="No recovery points yet" Message="After a backup is verified and uploaded, it appears here ready to restore." /> }
        else { <Empty Art="search" Title="Nothing matches" Message="Try another search or site." /> }
    }
    else
    {
        <div class="ui-list__head cols-point" aria-hidden="true"><span></span><span>Backup</span><span>Stored on</span><span style="text-align:right">Size</span><span>Check</span><span></span></div>
        <div class="ui-list" role="list">
            @foreach (var day in _page.Items.GroupBy(p => DayLabel(p.CompletedAt ?? p.CreatedAt)))
            {
                <div class="ui-list__group">@day.Key<span class="ui-count">@day.Count()</span></div>
                @foreach (var p in day)
                {
                    var restorable = p.Status == OffloadStatusDto.Completed && p.RetentionState is RetentionStateDto.Active or RetentionStateDto.Expired;
                    <div class="ui-list__row cols-point" role="listitem">
                        <span class="ui-glyph @(p.IsReplica ? "" : "ui-glyph--accent")" title="@(p.IsReplica ? "DR copy" : "Primary copy")"><Icon Name="@(p.IsReplica ? "topology" : "s3")" Size="14" /></span>
                        <span class="row" style="min-width:0;gap:8px"><span class="ui-list__title" style="flex:none;max-width:60%">@p.JobName</span><span class="ui-list__sub">@p.ServerName · @TimeOf(p.CompletedAt ?? p.CreatedAt)</span></span>
                        <span class="ui-list__meta hide-sm">@p.DestinationName@(p.IsReplica ? " · DR" : "")@if (p.Encrypted) { <Icon Name="lock" Size="12" Class="muted" /> }</span>
                        <span class="ui-list__meta hide-sm" style="text-align:right">@(p.BytesTotal is null ? p.LegacyTotalSize ?? "—" : Fmt.Bytes(p.BytesTotal))</span>
                        <span class="hide-sm">@if (p.Status != OffloadStatusDto.Completed) { <StatusBadge View="StatusMap.Offload(p)" /> } else { <StatusBadge View="StatusMap.Verification(p.VerificationStatus)" /> }</span>
                        <span class="cell-end">@if (restorable && Can(Permissions.RestoresExecute)) { <Btn Size="sm" Href="@($"/restores/new?recoveryPointId={p.Id}")" Icon="restore">Restore</Btn> } else if (p.IsProtected) { <span class="xs muted" title="@p.ProtectionReason">Kept</span> }</span>
                    </div>
                }
            }
        </div>
        <Pager Page="_pageNo" PageSize="PageSize" Total="_page.Total" One="recovery point" Many="recovery points" OnChange="GoAsync" />
    }
</div>

@code {
    private const int PageSize = 25;
    private PagedResult<OffloadSummaryDto>? _page;
    private List<S3DestinationDto> _sites = [];
    private string? _error, _q;
    private long? _site;
    private int _pageNo = 1;

    private string DayLabel(DateTimeOffset at)
    {
        var d = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(at, Clock.Zone).DateTime);
        var today = DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Clock.Zone).DateTime);
        return d == today ? "Today" : d == today.AddDays(-1) ? "Yesterday" : d.ToString("dddd, d MMMM", CultureInfo.InvariantCulture);
    }

    protected override async Task OnPageInitializedAsync()
    {
        if (Can(Permissions.StorageRead)) { var s = await Api.Storage.ListAsync(); _sites = s.Value ?? []; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        var r = await Api.RecoveryPoints.ListAsync(new RecoveryPointFilter(DestinationId: _site, Q: _q), _pageNo, PageSize, "-createdAt");
        _error = ErrorOf(r); _page = r.Value;
    }

    private Task SearchAsync(string? q) { _q = q; _pageNo = 1; return LoadAsync(); }
    private string TimeOf(DateTimeOffset at) => TimeZoneInfo.ConvertTime(at, Clock.Zone).ToString("HH:mm", CultureInfo.InvariantCulture);
    private Task SetSite(long? id) { _site = id; _pageNo = 1; _page = null; return LoadAsync(); }
    private Task GoAsync(int p) { _pageNo = p; return LoadAsync(); }
}
