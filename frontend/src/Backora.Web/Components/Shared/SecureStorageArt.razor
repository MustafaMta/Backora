@* Encrypted upload, explained: backup → encrypted with your public key on the execution host → bucket. The private key stays with you. *@
<svg viewBox="0 0 280 96" fill="none" role="img" aria-label="@(Encrypted ? "Backups are encrypted with your public key before upload; only your private key can decrypt them" : "Backups are uploaded over TLS and protected by the provider's at-rest encryption")" style="width:100%;height:auto">
    <g fill="var(--surface)" stroke="var(--line)" stroke-width="1.2"><rect x="4" y="18" width="62" height="46" rx="10" /><rect x="109" y="18" width="62" height="46" rx="10" /><rect x="214" y="18" width="62" height="46" rx="10" /></g>
    <g stroke="@(Encrypted ? "var(--flow)" : "var(--line-strong)")" stroke-width="1.6" stroke-dasharray="@(Encrypted ? "0" : "3 4")"><path d="M66 41h43" /><path d="M171 41h43" /></g>
    <g stroke="var(--ink-3)" stroke-width="1.5" stroke-linecap="round"><path d="M25 31h20v20H25z" /><path d="M29 37h12M29 42h12M29 47h8" /></g>
    @if (Encrypted)
    {
        <g stroke="var(--flow)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="130" y="38" width="20" height="15" rx="3" /><path d="M134 38v-4a6 6 0 0 1 12 0v4" /></g>
    }
    else
    {
        <g stroke="var(--ink-3)" stroke-width="1.6" stroke-linecap="round"><path d="M128 41h24M140 29v24" opacity=".5" /></g>
    }
    <g stroke="var(--accent)" stroke-width="1.6"><ellipse cx="245" cy="33" rx="12" ry="4.2" /><path d="M233 33v14c0 2.3 5.4 4.2 12 4.2s12-1.9 12-4.2V33" /></g>
    <g fill="var(--ink-3)" font-family="Geist, sans-serif" font-size="9.5" text-anchor="middle"><text x="35" y="78">Backup</text><text x="140" y="78">@(Encrypted ? "Encrypted" : "Sent over TLS")</text><text x="245" y="78">Your bucket</text></g>
    @if (Encrypted)
    {
        <g transform="translate(118 84)"><g stroke="var(--warn-dot)" stroke-width="1.4" stroke-linecap="round"><circle cx="4" cy="4" r="3" /><path d="M7 4h9M13 4v3" /></g><text x="20" y="7.5" fill="var(--ink-3)" font-family="Geist, sans-serif" font-size="8.5">private key stays with you</text></g>
    }
</svg>
@code { [Parameter] public bool Encrypted { get; set; } }
