# Copy to .env (or run ./generate-env.sh). All values are required unless marked optional.
BACKORA_VERSION=2.0.0
BACKORA_DOMAIN=backora.example.com
BACKORA_PUBLIC_URL=https://backora.example.com
BACKORA_TLS_MODE=acme            # acme | internal | files
ACME_EMAIL=ops@example.com
POSTGRES_PASSWORD=change-me
BACKORA_OWNER_PASSWORD=change-me
BACKORA_APP_PASSWORD=change-me
BACKORA_ENCRYPTION_KEY=base64-32-bytes
BACKORA_JWT_SIGNING_KEY=base64-48-bytes
BACKORA_ADMIN_EMAIL=admin@example.com
BACKORA_ADMIN_PASSWORD=change-me
BACKORA_EXECUTION_HOST_KEY_FILE=./secrets/execution_host_key
# Optional
# BACKORA_REGISTRY=registry.example.com/backora
# BACKORA_PROJECT=backora
# BACKORA_HTTP_PORT=80
# BACKORA_HTTPS_PORT=443
# BACKORA_MAX_CONCURRENT_BACKUPS=10
# BACKORA_MAX_CONCURRENT_TRANSFERS=4
# OTEL_EXPORTER_OTLP_ENDPOINT=
