@page "/users"
<PageTitle>Users &amp; access · Backora</PageTitle>

<PageHead Title="Users &amp; access">
    <Actions>@if (Can(Permissions.UsersManage)) { <Btn Variant="primary" Icon="plus" OnClick="OpenInvite">Invite user</Btn> }</Actions>
    <Below><div class="viewbar"><AccessTabs Active="users" /><div class="viewbar__end"><SearchBox Placeholder="Filter by name or email" Value="@_q" OnSearch="SearchAsync" /></div></div></Below>
</PageHead>

<div class="app-page">
    @if (_error is not null) { <Empty Error="true" Title="We couldn't load users" Message="@_error"><Actions><Btn OnClick="LoadAsync" Icon="refresh">Try again</Btn></Actions></Empty> }
    else if (_page is null) { <ListSkel Rows="4" /> }
    else if (_page.Items.Count == 0) { <Empty Icon="users" Title="No users match" /> }
    else
    {
        <div class="ui-list__head cols-user" aria-hidden="true"><span></span><span>Name</span><span>Role</span><span>Last sign-in</span><span>Status</span><span></span></div>
        <div class="ui-list" role="list">
            @foreach (var u in _page.Items)
            {
                <a class="ui-list__row cols-user" href="/users/@u.Id" role="listitem">
                    <span class="ui-avatar">@Fmt.Initials(u.Name)</span>
                    <span class="row" style="min-width:0;gap:8px"><span class="ui-list__title" style="flex:none;max-width:55%">@u.Name</span><span class="ui-list__sub">@u.Email</span></span>
                    <span class="ui-list__meta hide-sm">@RoleNames(u.Roles)</span>
                    <span class="ui-list__meta hide-sm">@(u.LastLoginAt is null ? "Never" : Fmt.Relative(u.LastLoginAt))</span>
                    <StatusBadge View="State(u)" />
                    <Icon Name="chevron-right" Size="14" Class="chev hide-sm" />
                </a>
            }
        </div>
        <Pager Total="_page.Total" One="user" Many="users" />
    }
</div>

<Drawer @bind-Open="_invite" Title="Invite a user" Subtitle="They sign in with this email and a temporary password." Icon="users">
    <ChildContent>
        @if (_inviteError is not null) { <div class="ui-callout ui-callout--bad" role="alert"><Icon Name="circle-alert" Size="15" /><div>@_inviteError</div></div> }
        <FormField Label="Full name" For="iv-name" Error="@_inviteResult?.FieldError("Name")"><input id="iv-name" class="ui-input" @bind="_ivName" autocomplete="off" /></FormField>
        <FormField Label="Work email" For="iv-email" Error="@_inviteResult?.FieldError("Email")"><div class="ui-input-wrap"><Icon Name="mail" Size="14" /><input id="iv-email" class="ui-input" type="email" @bind="_ivEmail" autocomplete="off" /></div></FormField>
        <FormField Label="Temporary password" For="iv-pw" Hint="Share it privately. They must change it at first sign-in." Error="@_inviteResult?.FieldError("Password")">
            <div class="ui-input-group"><input id="iv-pw" class="ui-input mono" type="@(_showPw ? "text" : "password")" @bind="_ivPassword" autocomplete="new-password" /><button type="button" class="ui-input-group__addon" style="cursor:pointer" @onclick="() => _showPw = !_showPw" aria-label="@(_showPw ? "Hide password" : "Show password")"><Icon Name="@(_showPw ? "eye-off" : "eye")" Size="14" /></button></div>
        </FormField>
        <div><Btn Size="sm" Variant="ghost" Icon="sparkles" OnClick="GeneratePassword">Generate a strong password</Btn></div>
        <div class="stack-sm">
            <span class="ui-label">Access</span>
            <div class="ui-choices" role="group" aria-label="Roles">
                @foreach (var r in _roleList)
                {
                    <Choice Multi="true" Title="@r.DisplayName" Subtitle="@r.Description" Icon="@RoleIcon(r.Name)" Selected="_ivRoles.Contains(r.Name)" OnSelect="() => { if (!_ivRoles.Remove(r.Name)) _ivRoles.Add(r.Name); }" />
                }
            </div>
            @if (_inviteResult?.FieldError("Roles") is { } re) { <span class="ui-error"><Icon Name="alert" Size="12" />@re</span> }
        </div>
    </ChildContent>
    <Footer>
        <Btn Variant="ghost" OnClick="() => _invite = false">Cancel</Btn>
        <Btn Variant="primary" Icon="check" Busy="_inviting" Disabled="@(string.IsNullOrWhiteSpace(_ivName) || string.IsNullOrWhiteSpace(_ivEmail) || string.IsNullOrEmpty(_ivPassword) || _ivRoles.Count == 0)" OnClick="InviteAsync">Create user</Btn>
    </Footer>
</Drawer>

@code {
    [SupplyParameterFromQuery(Name = "invite")] public int? InviteParam { get; set; }
    private bool _invite, _inviting, _showPw;
    private string? _ivName, _ivEmail, _ivPassword, _inviteError;
    private readonly HashSet<string> _ivRoles = new(StringComparer.Ordinal);
    private ApiResult? _inviteResult;
    private List<RoleDto> _roleList = [];

    private static string RoleIcon(string role) => role switch
    {
        Roles.PlatformAdministrator => "shield", Roles.BackupAdministrator => "jobs", Roles.BackupOperator => "play",
        Roles.RestoreOperator => "restore", Roles.Auditor => "audit", _ => "eye",
    };

    private void OpenInvite()
    {
        _ivName = _ivEmail = _ivPassword = _inviteError = null; _inviteResult = null; _ivRoles.Clear(); _ivRoles.Add(Roles.Viewer); _invite = true;
    }

    private void GeneratePassword()
    {
        const string alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789-_!";
        _ivPassword = System.Security.Cryptography.RandomNumberGenerator.GetString(alphabet, 18);
        _showPw = true;
    }

    private async Task InviteAsync()
    {
        _inviting = true; _inviteError = null;
        var r = await Api.Users.CreateAsync(new CreateUserRequest(_ivEmail!.Trim(), _ivName!.Trim(), _ivPassword!, _ivRoles.ToList()));
        _inviting = false; _inviteResult = r;
        if (r.Ok && r.Value is not null) { _ivPassword = null; _invite = false; Toasts.Success("User created", r.Value.Name); Nav.NavigateTo($"/users/{r.Value.Id}"); return; }
        if (r.Outcome is ApiOutcome.ValidationFailed or ApiOutcome.Conflict) { _inviteError = r.Message; return; }
        Handle(r);
    }

    private PagedResult<UserDto>? _page;
    private Dictionary<string, string> _roles = new(StringComparer.Ordinal);
    private string? _error, _q;

    internal static StatusView State(UserDto u) =>
        !u.IsActive ? new("Disabled", StatusTone.Neutral, "pause")
        : u.LockedOutUntil is { } l && l > DateTimeOffset.UtcNow ? new("Locked", StatusTone.Warning, null, $"Locked until {l:u}")
        : new(u.TwoFactorEnabled ? "Active · 2FA" : "Active", StatusTone.Success);

    private string RoleNames(IReadOnlyList<string> roles) => roles.Count == 0 ? "No role" : string.Join(", ", roles.Select(r => _roles.TryGetValue(r, out var n) ? n : r));

    protected override async Task OnPageInitializedAsync()
    {
        var roles = await Api.Users.RolesAsync();
        _roleList = roles.Value ?? [];
        _roles = roles.Value?.ToDictionary(r => r.Name, r => r.DisplayName, StringComparer.Ordinal) ?? new(StringComparer.Ordinal);
        if (InviteParam == 1 && Can(Permissions.UsersManage)) OpenInvite();
        await LoadAsync();
    }
    private async Task LoadAsync() { _error = null; var r = await Api.Users.ListAsync(_q, 1, 200, "name"); _error = ErrorOf(r); _page = r.Value; }
    private Task SearchAsync(string? q) { _q = q; return LoadAsync(); }
}
